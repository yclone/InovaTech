{
  "name": "inovatech-mobile-tests",
  "version": "1.0.0",
  "description": "InovaTech mobile automation tests with Appium and WebdriverIO",
  "main": "./app/android/wdio.conf.android.js",
  "scripts": {
    "uiautomator2:install": "npx appium driver install uiautomator2",
    "driver:list": "npx appium driver list",
    "appium": "appium server --address 127.0.0.1 --port 4723",
    "test": "npx wdio ./app/android/wdio.conf.android.js",
    "test:android": "npx wdio ./app/android/wdio.conf.android.js",
    "report:generate": "node node_modules/wdio-html-nice-reporter/lib/makeReport.js index.html 'reports/html-reports/'",
    "report:prepare": "node reportManager/index.js",
    "lint-fix": "npx eslint --fix {app,reportManager}/**/*.js",
    "format": "npx prettier -w {app,reportManager}/**/*.js",
    "audit": "npm audit --registry=https://registry.npmjs.org/ --production"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "mobile",
    "testing",
    "automation"
  ],
  "author": "InovaTech Team",
  "license": "ISC",
  "dependencies": {
    "@wdio/cli": "8.8.6",
    "appium": "2.1.3",
    "chai": "4.3.7",
    "wdio-html-nice-reporter": "8.1.3-beta",
    "webdriverio": "8.10.2"
  },
  "devDependencies": {
    "@wdio/appium-service": "8.8.6",
    "@wdio/local-runner": "8.8.6",
    "@wdio/mocha-framework": "8.8.6",
    "@wdio/spec-reporter": "8.8.6",
    "appium-uiautomator2-driver": "2.29.5",
    "dotenv": "16.3.1",
    "eslint": "8.49.0",
    "husky": "8.0.3",
    "prettier": "3.0.3",
    "ts-node": "10.9.1"
  }
}
