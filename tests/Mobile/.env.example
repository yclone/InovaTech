# ===========================================
# Configurações do Projeto de Testes Mobile
# ===========================================
# Copie este arquivo para .env e ajuste conforme necessário
# Comando: copy .env.example .env

# -------------------------------------------
# Device Configuration
# -------------------------------------------
# Nome do dispositivo/emulador (use 'adb devices' para listar)
ANDROID_DEVICE_NAME=emulator-5554

# Versão do Android no dispositivo (ex: 13.0, 14.0, 15.0)
ANDROID_PLATFORM_VERSION=16.0

# -------------------------------------------
# Appium Configuration
# -------------------------------------------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# -------------------------------------------
# App Configuration
# -------------------------------------------
# Caminho para o APK do aplicativo
APP_PATH=./APK/app-debug.apk

# Package e Activity do aplicativo Android
APP_PACKAGE=com.example.inovatechmob
APP_ACTIVITY=.MainActivity

# -------------------------------------------
# API Backend Configuration
# -------------------------------------------
# URL base da API backend (use 10.0.2.2 para localhost no emulador)
# Para emulador: http://10.0.2.2:8080/api
# Para dispositivo real: http://<IP_DA_MAQUINA>:8080/api
API_BASE_URL=http://10.0.2.2:8080/api

# -------------------------------------------
# Test Configuration
# -------------------------------------------
# Timeout global para os testes (em milissegundos)
TEST_TIMEOUT=60000

# Tempo de espera implícito para encontrar elementos (em milissegundos)
IMPLICIT_WAIT=10000

# Timeout para aguardar elementos específicos (em milissegundos)
ELEMENT_WAIT_TIMEOUT=30000

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
# Nível de log: trace, debug, info, warn, error, silent
LOG_LEVEL=info

# Salvar logs em arquivo
SAVE_LOGS=true

# -------------------------------------------
# Test User Credentials (para testes)
# -------------------------------------------
TEST_USER_EMAIL=teste@teste.com
TEST_USER_PASSWORD=123

# -------------------------------------------
# Report Configuration
# -------------------------------------------
# Diretório para salvar reports
REPORT_DIR=./reports

# Tipo de report: spec, dot, html-reporter
REPORT_TYPE=html-reporter


